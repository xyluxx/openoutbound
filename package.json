{
  "name": "openoutbound",
  "version": "0.1.0",
  "description": "The open-source AI SDR engine any agent can drive.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openoutbound": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/plugin.js"
  },
  "files": [
    "dist",
    "drizzle",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyluxx/openoutbound.git"
  },
  "homepage": "https://github.com/xyluxx/openoutbound#readme",
  "bugs": {
    "url": "https://github.com/xyluxx/openoutbound/issues"
  },
  "keywords": [
    "ai-sdr",
    "outbound",
    "mcp",
    "agent",
    "sales",
    "cold-email",
    "linkedin",
    "lead-generation"
  ],
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "openoutbound": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && node scripts/check-text.mjs && node scripts/check-links.mjs && tsx scripts/generate-settings-docs.ts --check && tsx scripts/generate-reference.ts --check",
    "db:generate": "drizzle-kit generate",
    "generate:reference": "tsx scripts/generate-reference.ts",
    "evals": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "read-excel-file": "^9.3.10",
    "robots-parser": "^3.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
