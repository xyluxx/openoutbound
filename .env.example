# OpenOutbound configuration.
# Copy to .env (or run `openoutbound init`, which writes one for you).
# Real environment variables always win over values in .env.

# --- Core -------------------------------------------------------------------

# Database: postgres://user:pass@host:5432/db (Postgres) | pglite://<dir> (embedded, on disk)
# | memory:// (embedded, in memory, lost on exit). Default: pglite://.openoutbound/pglite
DATABASE_URL=pglite://.openoutbound/pglite

# 32-byte key, base64, used to encrypt stored secrets (provider keys, mailbox passwords).
# Required unless DATABASE_URL is memory://. Generate: openssl rand -base64 32
OPENOUTBOUND_SECRET_KEY=

# Public URL of this instance: used in unsubscribe links, OAuth callbacks and webhook URLs.
OPENOUTBOUND_BASE_URL=http://localhost:7331

# HTTP server bind. Use HOST=0.0.0.0 inside Docker.
PORT=7331
HOST=127.0.0.1

# trace | debug | info | warn | error | fatal | silent. Logs go to stderr as JSON.
LOG_LEVEL=info

# API key the CLI uses to reach a server (--url, OPENOUTBOUND_URL, or a running `serve`), and
# `openoutbound mcp` only with --url or OPENOUTBOUND_URL: otherwise an agent session acts as the
# local agent (pass --api-key to choose a key), never as the key a person keeps here.
OPENOUTBOUND_API_KEY=

# MCP toolsets exposed to agents, comma separated:
# core, leads, campaigns, inbox, signals, content, admin, agent_brain, all
OPENOUTBOUND_MCP_TOOLSETS=core

# Scopes granted to the local embedded stdio MCP agent: read, write, send, spend, approve, admin.
# The default matches agent keys (no approve, no admin), so a person decides approvals. Add
# approve only if the agent may decide them; it can never approve its own requests.
OPENOUTBOUND_AGENT_SCOPES=read,write,send,spend

# Allow fetches and webhooks to private, loopback and link-local addresses (self-hosters only).
OPENOUTBOUND_ALLOW_PRIVATE_NETWORK=false

# --- AI brain (any one is enough; workspace settings override) -------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Lead sources ------------------------------------------------------------

APOLLO_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Research and search -----------------------------------------------------

PARALLEL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- Signals -----------------------------------------------------------------

PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
CRUSTDATA_API_KEY=

# --- Email finders and verifiers ----------------------------------------------

ICYPEAS_API_KEY=
FINDYMAIL_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
MILLIONVERIFIER_API_KEY=
REOON_API_KEY=

# --- LinkedIn (Unipile) and LinkedIn publishing ------------------------------

# Unipile DSN, for example api1.unipile.com:13111
UNIPILE_DSN=
UNIPILE_API_KEY=
# LinkedIn developer app for official post publishing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Mailbox OAuth (optional; app passwords work without these) --------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Microsoft Entra tenant id, or "common"
MICROSOFT_OAUTH_TENANT=

# --- CRM ---------------------------------------------------------------------

HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
# Slack and email notifications are set per workspace, not here:
# openoutbound --workspace <slug> notifications create --type slack_webhook --name Slack --url <url>
