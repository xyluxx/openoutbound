{
  "inputs": [
    {
      "type": "promptString",
      "id": "openoutbound-api-key",
      "description": "OpenOutbound API key (oo_...)",
      "password": true
    }
  ],
  "servers": {
    "openoutbound": {
      "type": "http",
      "url": "http://127.0.0.1:7331/mcp",
      "headers": {
        "Authorization": "Bearer ${input:openoutbound-api-key}",
        "OpenOutbound-Workspace": "northwind"
      }
    }
  }
}
